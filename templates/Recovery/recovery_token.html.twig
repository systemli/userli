{% extends 'base_step.html.twig' %}

{% block title %}{{ setting('app_name') }} - {{ "recovery.token-lead"|trans }}{% endblock %}

{% form_theme form 'Form/fields.html.twig' %}

{% block step_progress %}
    {% include 'Recovery/_steps.html.twig' with {current_step: 4} only %}
{% endblock %}

{% block step_title %}{{ "recovery.token-lead"|trans }}{% endblock %}

{% block step_description %}
    <p class="text-gray-600 dark:text-gray-300">{{ "recovery-token.lead"|trans }}</p>
{% endblock %}

{% block step_icon %}
    <div class="w-16 h-16 bg-blue-100 dark:bg-blue-900/50 rounded-xl flex items-center justify-center">
        {{ ux_icon('heroicons:ticket', {'class': 'w-8 h-8 text-blue-600 dark:text-blue-400'}) }}
    </div>
{% endblock %}

{% block step_content %}
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4 text-center">{{ "recovery-token.created-headline"|trans }}</h2>

    {% include 'Recovery/show_recovery_token.html.twig' %}
{% endblock %}
