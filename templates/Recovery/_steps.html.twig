{#
    Progress indicator for the password recovery.

    Variables:
      - current_step: 1 (start) to 4 (save the new recovery token)
#}
{% set recovery_steps = [
    'recovery.steps.start',
    'recovery.steps.wait',
    'recovery.steps.password',
    'recovery.steps.token',
] %}

<nav aria-label="{{ 'recovery.steps.label'|trans }}" class="mb-8">
    <ol class="flex items-start justify-between">
        {% for label in recovery_steps %}
            {% set step = loop.index %}
            <li class="relative flex-1 flex flex-col items-center text-center px-1"{% if step == current_step %} aria-current="step"{% endif %}>
                {% if not loop.first %}
                    {# Line from the previous circle to this one, drawn behind both circles #}
                    <span class="absolute top-4 right-1/2 w-full h-0.5 -translate-y-1/2 {% if step <= current_step %}bg-green-300 dark:bg-green-700{% else %}bg-gray-300 dark:bg-gray-600{% endif %}" aria-hidden="true"></span>
                {% endif %}
                {% if step < current_step %}
                    <span class="relative z-10 w-8 h-8 rounded-full flex items-center justify-center bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300">
                        {{ ux_icon('heroicons:check', {'class': 'w-4 h-4', 'aria-hidden': 'true'}) }}
                    </span>
                {% elseif step == current_step %}
                    <span class="relative z-10 w-8 h-8 rounded-full flex items-center justify-center bg-blue-600 dark:bg-blue-500 text-white text-sm font-semibold" aria-hidden="true">{{ step }}</span>
                {% else %}
                    <span class="relative z-10 w-8 h-8 rounded-full flex items-center justify-center border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-500 dark:text-gray-400 text-sm" aria-hidden="true">{{ step }}</span>
                {% endif %}
                <span class="mt-2 text-xs {% if step == current_step %}font-semibold text-gray-900 dark:text-gray-100{% else %}text-gray-500 dark:text-gray-400{% endif %}">
                    {{ label|trans }}
                    {% if step < current_step %}<span class="sr-only">({{ 'recovery.steps.done'|trans }})</span>{% endif %}
                </span>
            </li>
        {% endfor %}
    </ol>
</nav>
