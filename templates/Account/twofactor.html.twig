{% extends 'base_page.html.twig' %}

{% block title %}{{ setting('app_name') }} - {{ "account.twofactor.headline"|trans }}{% endblock %}

{% block page_title %}{{ "account.twofactor.headline"|trans }}{% endblock %}

{% block page_subtitle %}{{ "account.twofactor.lead"|trans }}{% endblock %}

{% set card_class = 'flex flex-col bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6' %}
{% set button_class = 'inline-flex justify-center w-full px-6 py-3 bg-blue-600 dark:bg-blue-500 text-white font-medium rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-colors duration-200' %}
{% set secondary_button_class = 'inline-flex justify-center w-full px-6 py-3 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-lg bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-colors duration-200' %}

{% macro status(enabled, label, warning = false) %}
    {% if enabled and warning %}
        <span class="inline-flex items-center px-2 py-1 bg-yellow-100 dark:bg-yellow-900/50 text-yellow-800 dark:text-yellow-200 text-xs font-medium rounded-full">
            {{ ux_icon('heroicons:exclamation-triangle-20-solid', {class: 'w-3 h-3 mr-1'}) }}
            {{ label }}
        </span>
    {% elseif enabled %}
        <span class="inline-flex items-center px-2 py-1 bg-green-100 dark:bg-green-900/50 text-green-800 dark:text-green-200 text-xs font-medium rounded-full">
            {{ ux_icon('heroicons:check-circle-20-solid', {class: 'w-3 h-3 mr-1'}) }}
            {{ label }}
        </span>
    {% else %}
        <span class="inline-flex items-center px-2 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-xs font-medium rounded-full">
            {{ label }}
        </span>
    {% endif %}
{% endmacro %}

{% block page_content %}
    <div class="max-w-5xl mx-auto space-y-8" data-controller="modal">
        <div class="flex items-center justify-between gap-4 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6" data-twofactor-status>
            <div class="flex items-center">
                <div class="w-12 h-12 {{ user.twofactorEnabled ? 'bg-green-100 dark:bg-green-900/50' : 'bg-yellow-100 dark:bg-yellow-900/50' }} rounded-xl flex items-center justify-center mr-4 flex-shrink-0">
                    {% if user.twofactorEnabled %}
                        {{ ux_icon('heroicons:shield-check', {'class': 'w-6 h-6 text-green-600 dark:text-green-400'}) }}
                    {% else %}
                        {{ ux_icon('heroicons:exclamation-triangle', {'class': 'w-6 h-6 text-yellow-600 dark:text-yellow-400'}) }}
                    {% endif %}
                </div>
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
                        {{ (user.twofactorEnabled ? "account.twofactor.overview-enabled" : "account.twofactor.overview-disabled")|trans }}
                    </h2>
                    <p class="text-sm text-gray-600 dark:text-gray-300">
                        {{ (user.twofactorEnabled ? "account.twofactor.overview-enabled-description" : "account.twofactor.enable-description")|trans }}
                    </p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {# Authenticator app #}
            <div class="{{ card_class }}" data-twofactor-method="totp">
                <div class="flex items-center justify-between mb-3">
                    <div class="w-10 h-10 bg-blue-100 dark:bg-blue-900/50 rounded-xl flex items-center justify-center">
                        {{ ux_icon('heroicons:device-phone-mobile', {'class': 'w-5 h-5 text-blue-600 dark:text-blue-400'}) }}
                    </div>
                    {{ _self.status(user.totpAuthenticationEnabled, (user.totpAuthenticationEnabled ? "account.twofactor.enabled" : "account.twofactor.disabled")|trans) }}
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">{{ "account.twofactor.totp-title"|trans }}</h3>
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-6 flex-grow">{{ "account.twofactor.totp-description"|trans }}</p>
                <a href="{{ path('account_twofactor_totp') }}" class="{{ user.totpAuthenticationEnabled ? secondary_button_class : button_class }}">
                    {{ (user.totpAuthenticationEnabled ? "account.twofactor.totp-manage" : "account.twofactor.setup-button")|trans }}
                </a>
            </div>

            {# Security keys #}
            <div class="{{ card_class }}" data-twofactor-method="webauthn">
                <div class="flex items-center justify-between mb-3">
                    <div class="w-10 h-10 bg-blue-100 dark:bg-blue-900/50 rounded-xl flex items-center justify-center">
                        {{ ux_icon('heroicons:key', {'class': 'w-5 h-5 text-blue-600 dark:text-blue-400'}) }}
                    </div>
                    {{ _self.status(webauthn_credentials is not empty, "account.webauthn.count"|trans({'%count%': webauthn_credentials|length})) }}
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">{{ "account.webauthn.title"|trans }}</h3>
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-6 flex-grow">{{ "account.webauthn.lead"|trans }}</p>
                <a href="{{ path('account_webauthn') }}" class="{{ webauthn_credentials is not empty ? secondary_button_class : button_class }}">
                    {{ (webauthn_credentials is not empty ? "account.twofactor.totp-manage" : "account.twofactor.add")|trans }}
                </a>
            </div>

            {# Backup codes #}
            <div class="{{ card_class }}" data-twofactor-method="backup-codes">
                <div class="flex items-center justify-between mb-3">
                    <div class="w-10 h-10 bg-blue-100 dark:bg-blue-900/50 rounded-xl flex items-center justify-center">
                        {{ ux_icon('heroicons:lifebuoy', {'class': 'w-5 h-5 text-blue-600 dark:text-blue-400'}) }}
                    </div>
                    {% if user.twofactorEnabled %}
                        {{ _self.status(true, "account.twofactor.backup-count"|trans({'%count%': user.totpBackupCodes|length}), user.totpBackupCodes|length <= 2) }}
                    {% endif %}
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">{{ "account.twofactor.backup-ack-lead"|trans }}</h3>
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-6 flex-grow">
                    {{ (user.twofactorEnabled ? "account.twofactor.backup-description" : "account.twofactor.backup-unavailable")|trans }}
                </p>
                {% if user.twofactorEnabled %}
                    <button type="button" data-action="modal#open" class="{{ secondary_button_class }}">
                        {{ "account.twofactor.backup-regenerate-short"|trans }}
                    </button>
                {% endif %}
            </div>
        </div>

        {% include 'Account/_twofactor_info.html.twig' %}

        {% if user.twofactorEnabled %}
            {% include '_delete_password_modal.html.twig' with {
                modal_title: 'account.twofactor.backup-regenerate-title'|trans,
                modal_description: 'account.twofactor.backup-regenerate-help'|trans,
                modal_action: path('account_twofactor_backup_regenerate'),
                modal_submit_label: 'account.twofactor.backup-regenerate-confirm'|trans,
                modal_password_label: 'form.password'|trans,
                modal_id: 'regenerate-backup-codes-modal-title',
            } %}
        {% endif %}
    </div>
{% endblock %}
