{% extends 'base_page.html.twig' %}

{% block title %}{{ setting('app_name') }} - {{ "account.app-passwords.title"|trans }}{% endblock %}

{% form_theme form 'Form/fields.html.twig' %}

{% block page_title %}{{ "account.app-passwords.title"|trans }}{% endblock %}

{% block page_subtitle %}{{ "account.app-passwords.lead"|trans }}{% endblock %}

{% block page_content %}
    <div class="max-w-5xl mx-auto space-y-8" data-controller="delete-modal">
        {% if app_password %}
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-yellow-300 dark:border-yellow-700 p-6 sm:p-8">
                <div class="flex items-center mb-2">
                    <div class="w-10 h-10 bg-yellow-100 dark:bg-yellow-900/50 rounded-xl flex items-center justify-center mr-3">
                        {{ ux_icon('heroicons:exclamation-triangle', {'class': 'w-5 h-5 text-yellow-600 dark:text-yellow-400'}) }}
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
                        {{ "account.app-passwords.created-headline"|trans }}
                    </h3>
                </div>
                <p class="mb-3 text-sm text-gray-600 dark:text-gray-300">
                    {{ "account.app-passwords.created-subtitle"|trans }}
                </p>
                <div class="bg-white dark:bg-gray-700 rounded border border-gray-200 dark:border-gray-600">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-3">
                        <code data-app-password class="text-sm font-mono text-gray-900 dark:text-gray-100 break-all select-all min-w-0 flex-1">{{ app_password }}</code>
                        <button type="button"
                                class="inline-flex items-center p-2 text-xs font-medium text-gray-600 dark:text-gray-300 bg-gray-50 dark:bg-gray-600 border border-gray-300 dark:border-gray-500 rounded-md hover:bg-gray-100 dark:hover:bg-gray-500 hover:text-gray-900 dark:hover:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-700 transition-colors duration-200 self-end sm:self-auto flex-shrink-0"
                                data-controller="clipboard tooltip"
                                data-clipboard-content-value="{{ app_password }}"
                                data-action="clipboard#copy"
                                title="{{ "copy-to-clipboard"|trans }}"
                                aria-label="{{ "copy-to-clipboard"|trans }}">
                            {{ ux_icon('heroicons:clipboard', {'class': 'w-4 h-4'}) }}
                        </button>
                    </div>
                </div>
            </div>
        {% endif %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8">
                {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                {{ form_errors(form) }}

                <div>
                    {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}}) }}
                    {{ form_errors(form.name) }}
                    {{ form_widget(form.name) }}
                </div>

                <div>
                    {{ form_label(form.password, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}}) }}
                    {{ form_errors(form.password) }}
                    {{ form_widget(form.password) }}
                    {{ form_help(form.password) }}
                </div>

                <div class="pt-4">
                    {{ form_widget(form.submit, {'attr': {'class': 'w-full'}}) }}
                </div>

                {{ form_end(form) }}
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8">
                <div class="flex items-center mb-6">
                    <div class="w-10 h-10 bg-blue-100 dark:bg-blue-900/50 rounded-full flex items-center justify-center mr-4">
                        {{ ux_icon('heroicons:information-circle', {'class': 'w-5 h-5 text-blue-600 dark:text-blue-400'}) }}
                    </div>
                    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">{{ "openpgp.information"|trans }}</h2>
                </div>
                <div class="space-y-3">
                    <div class="flex items-start">
                        {{ ux_icon('heroicons:check-circle-20-solid', {class: 'w-5 h-5 text-green-500 dark:text-green-400 mt-0.5 mr-2 flex-shrink-0'}) }}
                        <span class="text-gray-700 dark:text-gray-300">{{ "account.app-passwords.feature-mail-programs"|trans }}</span>
                    </div>
                    <div class="flex items-start">
                        {{ ux_icon('heroicons:check-circle-20-solid', {class: 'w-5 h-5 text-green-500 dark:text-green-400 mt-0.5 mr-2 flex-shrink-0'}) }}
                        <span class="text-gray-700 dark:text-gray-300">{{ "account.app-passwords.feature-leaked"|trans }}</span>
                    </div>
                    <div class="flex items-start">
                        {{ ux_icon('heroicons:check-circle-20-solid', {class: 'w-5 h-5 text-green-500 dark:text-green-400 mt-0.5 mr-2 flex-shrink-0'}) }}
                        <span class="text-gray-700 dark:text-gray-300">{{ "account.app-passwords.feature-lost-device"|trans }}</span>
                    </div>
                    <div class="flex items-start">
                        {{ ux_icon('heroicons:exclamation-triangle-20-solid', {class: 'w-5 h-5 text-amber-500 dark:text-amber-400 mt-0.5 mr-2 flex-shrink-0'}) }}
                        <span class="text-gray-700 dark:text-gray-300">{{ "account.app-passwords.limitation-login"|trans }}</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8">
            {% if app_passwords is empty %}
                <div class="text-center py-8 text-gray-500 dark:text-gray-300">
                    {{ ux_icon('heroicons:inbox', {class: 'w-12 h-12 mx-auto mb-3 text-gray-300 dark:text-gray-600'}) }}
                    <p class="text-sm">{{ "account.app-passwords.empty"|trans }}</p>
                </div>
            {% else %}
                <div class="space-y-2">
                    {% for item in app_passwords %}
                        <div data-app-password-row class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-md gap-3">
                            <div class="flex-1 min-w-0">
                                <span class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate block" title="{{ item.name }}">{{ item.name }}</span>
                                <span class="text-xs text-gray-500 dark:text-gray-400">
                                    {% if item.lastLoginTime %}{{ "account.app-passwords.last-used"|trans({'%when%': item.lastLoginTime|last_use}) }}{% else %}{{ "account.app-passwords.never-used"|trans }}{% endif %}
                                </span>
                            </div>
                            <form method="post"
                                  action="{{ path('account_app_passwords_delete', {id: item.id}) }}"
                                  data-action="submit->delete-modal#open"
                                  data-delete-modal-title-param="{{ 'delete.app-password.headline'|trans|e('html_attr') }}"
                                  data-delete-modal-message-param="{{ 'delete.app-password.lead_specific'|trans({'%name%': item.name|e})|e('html_attr') }}"
                                  class="inline-flex flex-shrink-0">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_app_password_' ~ item.id) }}">
                                <button type="submit"
                                        class="inline-flex items-center p-2 text-red-700 dark:text-red-400 bg-red-100 dark:bg-red-900/50 rounded hover:bg-red-200 dark:hover:bg-red-900 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-1 dark:focus:ring-offset-gray-700 transition-colors"
                                        title="{{ "account.app-passwords.delete"|trans }}"
                                        aria-label="{{ "account.app-passwords.delete"|trans }} {{ item.name }}"
                                        data-controller="tooltip">
                                    {{ ux_icon('heroicons:x-mark', {class: 'w-4 h-4'}) }}
                                </button>
                            </form>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {% include '_confirm_modal.html.twig' with {
            controller_name: 'delete-modal',
            confirm_label: 'account.app-passwords.delete',
        } %}
    </div>
{% endblock %}
