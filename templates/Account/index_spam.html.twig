{% extends 'base_page.html.twig' %}

{% block title %}{{ setting('app_name') }} - {{ "spam.title"|trans }}{% endblock %}

{% block page_title %}{{ "spam.title"|trans }}{% endblock %}

{% block page_subtitle %}{{ "spam.text"|trans }}{% endblock %}

{% block page_content %}
    {% set support_address = setting('support_address') %}
    <div class="space-y-4 text-center text-gray-700 dark:text-gray-300">
        <p>{{ "spam.contact"|trans }}</p>
        {% if support_address %}
            <p>{{ "spam.contact_address"|trans({'%address%': support_address}) }}</p>
        {% endif %}
    </div>
{% endblock %}
