{% extends 'base_page.html.twig' %}

{% block title %}{{ setting('app_name') }} - {{ "spam.title"|trans }}{% endblock %}

{% block page_title %}{{ "spam.title"|trans }}{% endblock %}

{% block page_content %}
    {% set support_address = setting('support_address') %}
    <div class="max-w-2xl mx-auto bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6 sm:p-10">
        <div class="text-center">
            <div class="w-16 h-16 mx-auto mb-6 p-4 bg-yellow-100 dark:bg-yellow-900/50 rounded-2xl">
                {{ ux_icon('heroicons:exclamation-triangle', {class: 'w-full h-full text-yellow-600 dark:text-yellow-400'}) }}
            </div>
            <p class="text-lg text-gray-900 dark:text-gray-100 font-medium leading-relaxed">{{ "spam.text"|trans }}</p>
        </div>

        <div class="mt-8">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">{{ "spam.limits-title"|trans }}</h2>
            <ul class="space-y-3 text-gray-700 dark:text-gray-300 leading-relaxed">
                <li class="flex items-start">
                    {{ ux_icon('heroicons:paper-airplane', {class: 'w-5 h-5 mt-0.5 mr-3 flex-shrink-0 text-gray-400 dark:text-gray-500'}) }}
                    <span>{{ "spam.limit-send"|trans }}</span>
                </li>
                <li class="flex items-start">
                    {{ ux_icon('heroicons:link', {class: 'w-5 h-5 mt-0.5 mr-3 flex-shrink-0 text-gray-400 dark:text-gray-500'}) }}
                    <span>{{ "spam.limit-services"|trans }}</span>
                </li>
            </ul>
        </div>

        <div class="mt-8 p-5 sm:p-6 rounded-xl bg-gray-50 dark:bg-gray-900/50 border border-gray-200 dark:border-gray-700 text-center">
            <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{{ "spam.contact"|trans }}</p>
            {% if support_address %}
                <p class="mt-4 text-gray-700 dark:text-gray-300">{{ "spam.contact_address"|trans }}</p>
                <a href="mailto:{{ support_address }}"
                   class="mt-2 inline-flex items-center text-lg font-semibold text-blue-600 dark:text-blue-400 hover:underline break-all focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 rounded">
                    {{ ux_icon('heroicons:envelope', {class: 'w-5 h-5 mr-2 flex-shrink-0'}) }}
                    {{ support_address }}
                </a>
            {% endif %}
        </div>
    </div>
{% endblock %}
