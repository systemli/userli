{% if hasNotifications('password_compromised') %}
    <div class="mb-6 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-lg p-4" role="alert" aria-live="polite">
        <div class="flex items-start">
            {{ ux_icon('heroicons:exclamation-triangle', {'class': 'w-5 h-5 text-red-400 dark:text-red-500 mt-0.5 mr-3 flex-shrink-0'}) }}
            <div class="flex-1 text-sm text-red-700 dark:text-red-200 leading-relaxed">
                <p class="mb-3">
                    <strong class="font-semibold">{{ 'notifications.password_compromised.title'|trans }}:</strong>
                    {{ 'notifications.password_compromised.message'|trans }}
                </p>
                <div class="sm:inline-flex sm:items-center">
                    <a href="{{ path('account_password') }}"
                       class="inline-flex w-full sm:w-auto justify-center items-center px-3 py-1.5 rounded-md bg-red-600 dark:bg-red-500 text-white text-xs font-medium hover:bg-red-700 dark:hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-colors"
                    >{{ 'notifications.password_compromised.button'|trans }}</a>
                </div>
            </div>
        </div>
    </div>
{% endif %}
{% set recovery_start_time = activeRecoveryStartTime() %}
{% if recovery_start_time %}
    <div class="mb-6 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-lg p-4" role="alert" aria-live="polite">
        <div class="flex items-start">
            {{ ux_icon('heroicons:shield-exclamation', {'class': 'w-5 h-5 text-red-400 dark:text-red-500 mt-0.5 mr-3 flex-shrink-0'}) }}
            <div class="flex-1 text-sm text-red-700 dark:text-red-200 leading-relaxed">
                <p class="mb-3">
                    <strong class="font-semibold">{{ 'notifications.recovery_in_progress.title'|trans }}:</strong>
                    {{ 'notifications.recovery_in_progress.message'|trans({'%time%': recovery_start_time|format_datetime('medium', 'short')}) }}
                </p>
                <div class="flex flex-col sm:flex-row gap-2">
                    <a href="{{ path('account_recovery_token') }}"
                       class="inline-flex justify-center items-center px-3 py-1.5 rounded-md bg-red-600 dark:bg-red-500 text-white text-xs font-medium hover:bg-red-700 dark:hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-colors"
                    >{{ 'notifications.recovery_in_progress.button'|trans }}</a>
                    <form method="post" action="{{ path('account_recovery_cancel') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('account_recovery_cancel') }}">
                        <button type="submit"
                                class="inline-flex w-full sm:w-auto justify-center items-center px-3 py-1.5 cursor-pointer rounded-md border border-red-300 dark:border-red-700 bg-white dark:bg-gray-800 text-red-700 dark:text-red-200 text-xs font-medium hover:bg-red-50 dark:hover:bg-red-900/50 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-colors"
                        >{{ 'notifications.recovery_in_progress.cancel'|trans }}</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endif %}
